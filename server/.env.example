# ── Groq AI ─────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional automatic fallback whenever the Groq call above fails for any
# reason (rate limit, quota exhausted, network error) — see
# callWithFallback() in server/routes/groq.js. Leave unset to just fail
# on a Groq error instead. Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Examly Portal (all confirmed) ────────────────────────────────────────────
EXAMLY_BASE_URL=https://api.examly.io
SCHOOL_ID=041909ab-d1f3-4165-98a9-a513d85388b9

# ── Examly endpoint overrides (only change if the default is wrong) ──────────
# QB list      : POST /api/v2/questionbanks                  ✓ confirmed
# QB questions : POST /api/v2/questionbanks/:id/questions    ← best guess, update if wrong
# Create test  : needs to be confirmed — share network request when creating a test
EXAMLY_CREATE_TEST_ENDPOINT=/api/v2/tests

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001
